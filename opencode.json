{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent",
        "--project",
        "ict2.0"
      ],
      "environment": {
        "ENGRAM_PROJECT": "ict2.0"
      },
      "cwd": "."
    },
    "graphify": {
      "type": "local",
      "command": [
        "C:\\Python314\\python.exe",
        "-m",
        "graphify.serve",
        "C:\\Users\\v_jac\\Desktop\\ICT SYSTEM\\graphify-out\\graph.json"
      ],
      "enabled": true,
      "cwd": "C:\\Users\\v_jac\\Desktop\\ICT SYSTEM"
    }
  },
  "permission": {
    "context7_*": "allow",
    "engram_*": "allow",
    "graphify_*": "allow"
  },
  "agent": {
    "architect": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "conductor": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "scout": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "implementer": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "auditor": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "documenter": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "discoverer": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "researcher": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } },
    "gentle-orchestrator": { "permission": { "context7_*": "allow", "engram_*": "allow", "graphify_*": "allow" } }
  }
}
